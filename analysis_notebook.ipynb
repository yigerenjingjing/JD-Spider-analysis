   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 京东宠物玩具评论数据分析\n",
    "\n",
    "基于 jieba + TF-IDF 关键词提取、情感分析、统计检验的完整分析流程。\n",
    "\n",
    "数据来源：爬虫生成的 Excel 文件 或 MySQL 数据库。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import re\n",
    "import sys\n",
    "from collections import Counter\n",
    "from datetime import datetime\n",
    "\n",
    "import jieba\n",
    "import jieba.analyse\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from scipy import stats\n",
    "from wordcloud import WordCloud\n",
    "\n",
    "# 中文显示\n",
    "plt.rcParams['font.sans-serif'] = ['Microsoft YaHei', 'SimHei', 'DejaVu Sans']\n",
    "plt.rcParams['axes.unicode_minus'] = False\n",
    "\n",
    "print(f\"pandas {pd.__version__}  |  jieba {jieba.__version__}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. 数据加载\n",
    "\n",
    "支持从 Excel 或 MySQL 两种方式加载。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ────── 方式一：从 Excel 加载 ──────\n",
    "def load_from_excel(excel_path=r\"D:\\jd_result.xlsx\"):\n",
    "    xls = pd.ExcelFile(excel_path)\n",
    "    overview = pd.read_excel(xls, sheet_name=\"商品总览\")\n",
    "    comments_data = []\n",
    "    for sheet in xls.sheet_names[1:]:\n",
    "        df = pd.read_excel(xls, sheet_name=sheet)\n",
    "        comments_data.append({\n",
    "            \"product\": sheet,\n",
    "            \"comments\": df.iloc[:, 0].dropna().tolist(),\n",
    "        })\n",
    "    return overview, comments_data\n",
    "\n",
    "\n",
    "# ────── 方式二：从 MySQL 加载 ──────\n",
    "def load_from_mysql():\n",
    "    sys.path.insert(0, \".\")\n",
    "    from mysql.store_to_mysql import load_all_data\n",
    "    products, comments_data = load_all_data()\n",
    "    return products, comments_data\n",
    "\n",
    "\n",
    "# 默认使用 Excel 加载，可切换为 load_from_mysql()\n",
    "overview, comments_data = load_from_excel()\n",
    "\n",
    "print(f\"商品数: {len(overview)}\")\n",
    "print(f\"评论组数: {len(comments_data)}\")\n",
    "print(f\"总评论数: {sum(len(d['comments']) for d in comments_data)}\")\n",
    "overview.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. 数据预处理\n",
    "\n",
    "解析价格、销量数值、好评率。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def parse_sales_and_rate(overview):\n",
    "    products = []\n",
    "    for _, row in overview.iterrows():\n",
    "        sales_text = str(row.get(\"销量\", \"\"))\n",
    "        sales_num = 0\n",
    "        rate = 0\n",
    "\n",
    "        m = re.search(r\"已售(\\d+)万\", sales_text)\n",
    "        if m:\n",
    "            sales_num = int(m.group(1)) * 10000\n",
    "        else:\n",
    "            m = re.search(r\"已售(\\d+)\\\+\", sales_text)\n",
    "            if m:\n",
    "                sales_num = int(m.group(1))\n",
    "            else:\n",
    "                m = re.search(r\"(\\d+)万\\+\", sales_text)\n",
    "                if m:\n",
    "                    sales_num = int(m.group(1)) * 10000\n",
    "\n",
    "        m2 = re.search(r\"(\\d+)%好评\", sales_text)\n",
    "        if m2:\n",
    "            rate = int(m2.group(1))\n",
    "\n",
    "        try:\n",
    "            price = float(str(row.get(\"价格\", \"0\")).replace(\"¥\", \"\"))\n",
    "        except ValueError:\n",
    "            price = 0.0\n",
    "\n",
    "        products.append({\n",
    "            \"name\": str(row.get(\"商品名称\", \"\")),\n",
    "            \"price\": price,\n",
    "            \"price_display\": str(row.get(\"价格\", \"\")),\n",
    "            \"store\": str(row.get(\"店铺名称\", \"\")),\n",
    "            \"sales_text\": sales_text,\n",
    "            \"sales_num\": sales_num,\n",
    "            \"good_rate\": rate,\n",
    "        })\n",
    "    return products\n",
    "\n",
    "\n",
    "products = parse_sales_and_rate(overview)\n",
    "df_products = pd.DataFrame(products)\n",
    "df_products[[\"name\", \"price\", \"sales_num\", \"good_rate\", \"store\"]].head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. 情感分析（词典匹配）\n",
    "\n",
    "使用正面/负面情感词典对每条评论打分。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "POSITIVE_WORDS = {\n",
    "    \"好\", \"棒\", \"满意\", \"喜欢\", \"推荐\", \"不错\", \"赞\", \"超赞\", \"完美\", \"优秀\",\n",
    "    \"给力\", \"好评\", \"耐用\", \"结实\", \"厚实\", \"稳固\", \"方便\", \"舒服\", \"舒适\",\n",
    "    \"安全\", \"开心\", \"迅速\", \"很快\", \"靠谱\", \"信赖\", \"回购\", \"划算\", \"超值\",\n",
    "    \"惊喜\", \"漂亮\", \"可爱\", \"精细\", \"放心\", \"贴心\", \"爱不释手\", \"一流\",\n",
    "    \"高品质\", \"省心\", \"物美价廉\", \"性价比高\", \"值得\", \"必备\", \"神器\",\n",
    "    \"不占地\", \"良心\", \"到位\", \"周到\", \"及时\", \"好看\", \"整洁\", \"干净\",\n",
    "    \"温和\", \"柔软\", \"有弹性\", \"尽情\", \"挺好\", \"非常好\", \"很棒\", \"便宜\",\n",
    "    \"物超所值\", \"棒棒哒\", \"不贵\", \"给力\",\n",
    "}\n",
    "\n",
    "NEGATIVE_WORDS = {\n",
    "    \"差\", \"不好\", \"失望\", \"垃圾\", \"坑\", \"差劲\", \"烂\", \"糟糕\", \"坏\",\n",
    "    \"异味\", \"气味\", \"味道大\", \"臭\", \"难闻\", \"刺鼻\",\n",
    "    \"掉屑\", \"飞渣\", \"掉渣\", \"坏了\", \"破损\", \"损坏\", \"烂了\",\n",
    "    \"不值\", \"贵\", \"稍贵\", \"不太\", \"不推荐\", \"后悔\", \"退\", \"换货\",\n",
    "    \"问题\", \"缺陷\", \"缺点\", \"瑕疵\", \"不足\", \"有点大\", \"太小\",\n",
    "    \"不喜欢\", \"不爱\", \"没兴趣\", \"不玩\", \"不怎么\", \"不怎么样\",\n",
    "    \"差评\", \"不好用\", \"不耐用\", \"容易坏\", \"很快坏\", \"质量差\",\n",
    "    \"失望\", \"闹心\", \"糟心\", \"差很多\",\n",
    "}\n",
    "\n",
    "\n",
    "def analyze_sentiment(text):\n",
    "    pos = sum(text.count(w) for w in POSITIVE_WORDS)\n",
    "    neg = sum(text.count(w) for w in NEGATIVE_WORDS)\n",
    "    if pos > neg:\n",
    "        return \"positive\", pos, neg\n",
    "    if neg > pos:\n",
    "        return \"negative\", pos, neg\n",
    "    return \"neutral\", pos, neg\n",
    "\n",
    "\n",
    "# 对所有评论进行情感分析\n",
    "sentiment_results = []\n",
    "all_labeled = []  # (product, text, label, length)\n",
    "for item in comments_data:\n",
    "    counts = {\"positive\": 0, \"neutral\": 0, \"negative\": 0}\n",
    "    for c in item[\"comments\"]:\n",
    "        label, pos, neg = analyze_sentiment(c)\n",
    "        counts[label] += 1\n",
    "        all_labeled.append({\n",
    "            \"product\": item[\"product\"],\n",
    "            \"text\": c,\n",
    "            \"label\": label,\n",
    "            \"pos\": pos,\n",
    "            \"neg\": neg,\n",
    "            \"length\": len(c),\n",
    "        })\n",
    "    sentiment_results.append({\"product\": item[\"product\"], **counts})\n",
    "\n",
    "df_sentiment = pd.DataFrame(sentiment_results)\n",
    "df_labeled = pd.DataFrame(all_labeled)\n",
    "\n",
    "print(\"=== 情感分析汇总 ===\")\n",
    "print(df_sentiment.to_string(index=False))\n",
    "print(f\"\\n正面: {df_labeled['label'].value_counts().get('positive', 0)}\")\n",
    "print(f\"中性: {df_labeled['label'].value_counts().get('neutral', 0)}\")\n",
    "print(f\"负面: {df_labeled['label'].value_counts().get('negative', 0)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 情感分布可视化\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# 堆叠柱状图\n",
    "df_sentiment.set_index(\"product\")[[\"positive\", \"neutral\", \"negative\"]].plot(\n",
    "    kind=\"bar\", stacked=True, ax=axes[0],\n",
    "    color=[\"#52c41a\", \"#faad14\", \"#e74c3c\"],\n",
    ")\n",
    "axes[0].set_title(\"评论情感分布（按商品）\", fontsize=14)\n",
    "axes[0].set_ylabel(\"评论数\")\n",
    "axes[0].legend([\"正面\", \"中性\", \"负面\"])\n",
    "axes[0].tick_params(axis=\"x\", rotation=20)\n",
    "\n",
    "# 饼图\n",
    "totals = df_sentiment[[\"positive\", \"neutral\", \"negative\"]].sum()\n",
    "axes[1].pie(totals, labels=[\"正面\", \"中性\", \"负面\"], autopct=\"%1.1f%%\",\n",
    "            colors=[\"#52c41a\", \"#faad14\", \"#e74c3c\"], startangle=90)\n",
    "axes[1].set_title(\"整体情感占比\", fontsize=14)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. jieba + TF-IDF 关键词提取\n",
    "\n",
    "替换硬编码关键词列表，使用 TF-IDF 自动提取有区分度的词。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "STOPWORDS = {\n",
    "    \"的\", \"了\", \"是\", \"我\", \"很\", \"也\", \"都\", \"不\", \"就\", \"和\", \"还\", \"一个\",\n",
    "    \"这个\", \"已经\", \"可以\", \"没有\", \"比较\", \"觉得\", \"知道\", \"因为\", \"所以\",\n",
    "    \"但是\", \"如果\", \"虽然\", \"而且\", \"或者\", \"不过\", \"然后\", \"之后\", \"还是\",\n",
    "    \"非常\", \"真的\", \"挺\", \"有点\", \"蛮\", \"太\", \"比较\", \"特别\", \"会\", \"要\",\n",
    "    \"在\", \"有\", \"买\", \"用\", \"给\", \"让\", \"把\", \"被\", \"对\", \"从\", \"到\",\n",
    "    \"出\", \"过\", \"着\", \"之\", \"中\", \"上\", \"下\", \"大\", \"小\", \"多\", \"少\",\n",
    "    \"好\", \"等\", \"该\", \"这\", \"那\", \"其\", \"它\", \"他\", \"她\", \"们\",\n",
    "    \"款式\", \"型号\", \"颜色\", \"规格\", \"京东\", \"物流\", \"快递\", \"配送\",\n",
    "    \"包装\", \"客服\", \"售后\", \"购物\", \"宝贝\", \"卖家\", \"店铺\", \"东西\",\n",
    "    \"收到\", \"打开\", \"拿到\", \"送来\", \"到货\", \"下单\", \"购买\", \"发货\",\n",
    "}\n",
    "\n",
    "\n",
    "def extract_keywords_tfidf(comments, topK=15):\n",
    "    \"\"\"使用 jieba TF-IDF 提取关键词。\"\"\"\n",
    "    all_text = \" \".join(comments)\n",
    "    tfidf = jieba.analyse.extract_tags(all_text, topK=topK, withWeight=True)\n",
    "    return [(w, round(s, 1)) for w, s in tfidf if w not in STOPWORDS and len(w) >= 2]\n",
    "\n",
    "\n",
    "# 全局 TF-IDF 关键词\n",
    "all_comments_text = \" \".join(c for item in comments_data for c in item[\"comments\"])\n",
    "global_tfidf = jieba.analyse.extract_tags(all_comments_text, topK=20, withWeight=True)\n",
    "global_kw = [(w, round(s, 1)) for w, s in global_tfidf if w not in STOPWORDS and len(w) >= 2]\n",
    "\n",
    "print(\"=== 全局 TF-IDF 关键词 Top 20 ===\")\n",
    "for w, s in global_kw[:20]:\n",
    "    print(f\"  {w}: {s}\")\n",
    "\n",
    "print(\"\\n=== 各商品 TF-IDF 关键词 Top 5 ===\")\n",
    "for item in comments_data:\n",
    "    kws = extract_keywords_tfidf(item[\"comments\"], topK=5)\n",
    "    print(f\"  [{item['product'][:20]}]: {', '.join(f'{w}({s})' for w, s in kws)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 关键词可视化\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "# 全局关键词柱状图\n",
    "words, scores = zip(*global_kw[:15])\n",
    "axes[0].barh(range(len(words)), scores[::-1], color=\"#722ed1\", height=0.6)\n",
    "axes[0].set_yticks(range(len(words)))\n",
    "axes[0].set_yticklabels(words[::-1])\n",
    "axes[0].set_xlabel(\"TF-IDF 权重\")\n",
    "axes[0].set_title(\"全局 TF-IDF 关键词 Top 15\", fontsize=14)\n",
    "for i, v in enumerate(scores[::-1]):\n",
    "    axes[0].text(v + 0.01, i, str(v), va=\"center\", fontsize=10)\n",
    "\n",
    "# 词频柱状图（纯频率对比）\n",
    "all_words = jieba.cut(all_comments_text)\n",
    "word_counts = Counter(w for w in all_words if w not in STOPWORDS and len(w) >= 2)\n",
    "top_freq = word_counts.most_common(15)\n",
    "fw, fs = zip(*top_freq)\n",
    "axes[1].barh(range(len(fw)), fs[::-1], color=\"#1890ff\", height=0.6)\n",
    "axes[1].set_yticks(range(len(fw)))\n",
    "axes[1].set_yticklabels(fw[::-1])\n",
    "axes[1].set_xlabel(\"出现次数\")\n",
    "axes[1].set_title(\"词频统计 Top 15\", fontsize=14)\n",
    "for i, v in enumerate(fs[::-1]):\n",
    "    axes[1].text(v + 0.5, i, str(v), va=\"center\", fontsize=10)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. 词云\n",
    "\n",
    "使用 TF-IDF 权重生成词云。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 构建 TF-IDF 权重字典\n",
    "tfidf_full = jieba.analyse.extract_tags(all_comments_text, topK=200, withWeight=True)\n",
    "tfidf_dict = {w: s for w, s in tfidf_full if w not in STOPWORDS and len(w) >= 2}\n",
    "\n",
    "wc = WordCloud(\n",
    "    font_path=\"C:/Windows/Fonts/msyh.ttc\",  # 微软雅黑，Windows 下可用\n",
    "    width=800, height=500,\n",
    "    background_color=\"white\",\n",
    "    max_words=100,\n",
    "    colormap=\"viridis\",\n",
    "    relative_scaling=0.5,\n",
    ")\n",
    "wc.generate_from_frequencies(tfidf_dict)\n",
    "\n",
    "plt.figure(figsize=(14, 8))\n",
    "plt.imshow(wc, interpolation=\"bilinear\")\n",
    "plt.axis(\"off\")\n",
    "plt.title(\"评论词云（TF-IDF 加权）\", fontsize=18, pad=15)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. 统计分析\n",
    "\n",
    "### 6.1 价格-销量 Pearson 相关分析"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 提取有效数据点\n",
    "valid = [(p[\"price\"], p[\"sales_num\"]) for p in products if p[\"price\"] > 0 and p[\"sales_num\"] > 0]\n",
    "prices = np.array([v[0] for v in valid])\n",
    "sales = np.array([v[1] for v in valid])\n",
    "\n",
    "print(f\"有效数据点: {len(valid)} 个\")\n",
    "\n",
    "if len(valid) >= 3:\n",
    "    r, p_value = stats.pearsonr(prices, sales)\n",
    "    print(f\"Pearson 相关系数 r = {r:.4f}\")\n",
    "    print(f\"p 值 = {p_value:.4f}\")\n",
    "    if p_value < 0.05:\n",
    "        if r < -0.3:\n",
    "            print(\"→ 显著负相关：低价商品销量更高\")\n",
    "        elif r > 0.3:\n",
    "            print(\"→ 显著正相关：高价商品销量反而更好\")\n",
    "        else:\n",
    "            print(\"→ 线性相关较弱\")\n",
    "    else:\n",
    "        print(\"→ 价格与销量无显著线性相关 (p >= 0.05)\")\n",
    "else:\n",
    "    r, p_value = None, None\n",
    "    print(\"样本不足（少于 3 个有效数据点），无法计算 Pearson 相关系数\")\n",
    "\n",
    "# 散点图 + 回归线\n",
    "fig, ax = plt.subplots(figsize=(8, 6))\n",
    "ax.scatter(prices, sales, s=80, c=\"#1890ff\", edgecolors=\"white\", linewidth=1, zorder=5)\n",
    "\n",
    "if len(valid) >= 3:\n",
    "    # 回归线\n",
    "    m, b = np.polyfit(prices, sales, 1)\n",
    "    x_line = np.linspace(prices.min() * 0.9, prices.max() * 1.1, 50)\n",
    "    ax.plot(x_line, m * x_line + b, \"--\", color=\"#e74c3c\", linewidth=2,\n",
    "            label=f\"回归线 (r={r:.3f}, p={p_value:.3f})\")\n",
    "    ax.legend(fontsize=11)\n",
    "\n",
    "ax.set_xlabel(\"价格 (¥)\", fontsize=12)\n",
    "ax.set_ylabel(\"销量\", fontsize=12)\n",
    "ax.set_title(\"价格 vs 销量 Pearson 相关分析\", fontsize=14)\n",
    "ax.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 6.2 正面 vs 负面评论长度 t 检验\n",
    "\n",
    "检验正面评论和负面评论的字数是否存在显著差异。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pos_lengths = df_labeled[df_labeled[\"label\"] == \"positive\"][\"length\"].tolist()\n",
    "neg_lengths = df_labeled[df_labeled[\"label\"] == \"negative\"][\"length\"].tolist()\n",
    "\n",
    "print(f\"正面评论数: {len(pos_lengths)}，均长: {np.mean(pos_lengths):.1f} ± {np.std(pos_lengths):.1f} 字\")\n",
    "print(f\"负面评论数: {len(neg_lengths)}，均长: {np.mean(neg_lengths):.1f} ± {np.std(neg_lengths):.1f} 字\")\n",
    "\n",
    "if len(pos_lengths) >= 2 and len(neg_lengths) >= 2:\n",
    "    t_stat, p_val = stats.ttest_ind(pos_lengths, neg_lengths, equal_var=False)\n",
    "    print(f\"\\nWelch's t 检验:\")\n",
    "    print(f\"  t 统计量 = {t_stat:.4f}\")\n",
    "    print(f\"  p 值 = {p_val:.4f}\")\n",
    "    if p_val < 0.05:\n",
    "        if t_stat > 0:\n",
    "            print(\"  → 正面评论显著更长 (p < 0.05)\")\n",
    "        else:\n",
    "            print(\"  → 负面评论显著更长 (p < 0.05)\")\n",
    "    else:\n",
    "        print(\"  → 两类评论长度无显著差异 (p >= 0.05)\")\n",
    "else:\n",
